write /Library/Application Support/host-telemetry/config.yaml (0600)
endpoint: http://127.0.0.1:8428/opentelemetry/api/v1/push
token: test
host_id: c32e69d5cb5c43ec914ddd62b271c773
host_name: box
listen: ""
wal_dir: ""
sensors: ""
write /Library/LaunchDaemons/dev.host-telemetry.plist (0644)
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.host-telemetry</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/host-telemetry</string>
		<string>run</string>
		<string>--config</string>
		<string>/Library/Application Support/host-telemetry/config.yaml</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>LowPriorityIO</key>
	<true/>
	<key>WorkingDirectory</key>
	<string>/Library/Application Support/host-telemetry</string>
	<key>StandardOutPath</key>
	<string>/Library/Application Support/host-telemetry/host-telemetry.log</string>
	<key>StandardErrorPath</key>
	<string>/Library/Application Support/host-telemetry/host-telemetry.log</string>
</dict>
</plist>
exec (ignore-errors) launchctl bootout system/dev.host-telemetry
exec launchctl bootstrap system /Library/LaunchDaemons/dev.host-telemetry.plist
exec launchctl enable system/dev.host-telemetry
exec launchctl kickstart -k system/dev.host-telemetry
